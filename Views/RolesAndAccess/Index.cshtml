@using QuanLiKhoHang.Models.Entities
@{
    var items = ViewBag.Items as List<Role>;
    var search = ViewBag.SearchTerm as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">@ViewBag.Title</h5>
                <a href="@Url.Action("CreateRole")" class="btn btn-primary">
                    <iconify-icon icon="mingcute:add-line" class="me-1"></iconify-icon>
                    Thêm vai trò
                </a>
            </div>

            <div class="card-body">
                <!-- Search Form -->
                <form method="get" class="mb-3">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <input type="text" name="search" value="@search" class="form-control"
                                placeholder="Tìm kiếm theo tên vai trò...">
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-outline-primary me-2">
                                <iconify-icon icon="mingcute:search-line"></iconify-icon>
                                Tìm kiếm
                            </button>
                            @if (!string.IsNullOrEmpty(search))
                            {
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                    <iconify-icon icon="mingcute:close-line"></iconify-icon>
                                    Xóa bộ lọc
                                </a>
                            }
                        </div>
                    </div>
                </form>

                <!-- Roles List -->
                @if (items != null && items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên vai trò</th>
                                    <th>Mô tả</th>
                                    <th>Quyền mặc định</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var role in items)
                                {
                                    <tr>
                                        <td>@role.Name</td>
                                        <td>@role.Description</td>
                                        <td>@role.DefaultPermissions</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="@Url.Action("EditRole", new { id = role.RoleId })" class="btn btn-sm btn-outline-primary">
                                                    <iconify-icon icon="mingcute:edit-line"></iconify-icon>
                                                </a>
                                                <form method="post" action="@Url.Action("DeleteRole", new { id = role.RoleId })" class="d-inline"
                                                      onsubmit="return confirm('Bạn có chắc muốn xóa vai trò này?')">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <iconify-icon icon="mingcute:delete-line"></iconify-icon>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (totalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @if (currentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, search })">Trước</a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, search })">@i</a>
                                    </li>
                                }

                                @if (currentPage < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, search })">Sau</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <iconify-icon icon="mingcute:user-star-line" class="text-muted" style="font-size: 3rem;"></iconify-icon>
                        <h5 class="text-muted mt-3">Không có vai trò nào</h5>
                        <p class="text-muted">Hãy tạo vai trò đầu tiên để bắt đầu.</p>
                        <a href="@Url.Action("CreateRole")" class="btn btn-primary">
                            <iconify-icon icon="mingcute:add-line" class="me-1"></iconify-icon>
                            Thêm vai trò
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>