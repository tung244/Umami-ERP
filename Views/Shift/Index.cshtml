@using QuanLiKhoHang.Models.Entities
@using QuanLiKhoHang.Models.Enums
@{
    var items = ViewBag.Items as List<Shift>;
    var search = ViewBag.SearchTerm as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Lịch làm việc</h5>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <iconify-icon icon="mingcute:add-line" class="me-1"></iconify-icon>
                    Thêm ca làm việc
                </a>
            </div>

            <div class="card-body">
                <!-- Search Form -->
                <form method="get" class="mb-3">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <input type="text" name="search" value="@search" class="form-control"
                                placeholder="Tìm kiếm theo tên ca hoặc chi nhánh">
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-outline-primary me-2">
                                <iconify-icon icon="mingcute:search-line"></iconify-icon>
                                Tìm kiếm
                            </button>
                            @if (!string.IsNullOrEmpty(search))
                            {
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                    <iconify-icon icon="mingcute:close-line"></iconify-icon>
                                    Xóa bộ lọc
                                </a>
                            }
                        </div>
                    </div>
                </form>

                <!-- Shift List -->
                @if (items != null && items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên ca</th>
                                    <th>Chi nhánh</th>
                                   
                                    <th>Giờ bắt đầu</th>
                                    <th>Giờ kết thúc</th>
                                   
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                             <tbody>
                                @foreach (var item in items)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Name</strong>
                                        </td>
                                        <td>@item.Branch?.Name</td>
                                        <td>@item.StartTime.ToString(@"hh\:mm")</td>
                                        <td>@item.EndTime.ToString(@"hh\:mm")</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="@Url.Action("Details", new { id = item.ShiftId })" class="btn btn-sm btn-outline-info">
                                                    <iconify-icon icon="mingcute:eye-line"></iconify-icon>
                                                </a>
                                                <a href="@Url.Action("Edit", new { id = item.ShiftId })" class="btn btn-sm btn-outline-primary">
                                                    <iconify-icon icon="mingcute:edit-line"></iconify-icon>
                                                </a>
                                                <form method="post" action="@Url.Action("Delete", new { id = item.ShiftId })" class="d-inline"
                                                     >
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                    onclick="return confirm('Bạn có chắc muốn xóa ca làm việc này?')">
                                                        <iconify-icon icon="mingcute:delete-line"></iconify-icon>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (totalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @if (currentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, search })">Trước</a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, search })">@i</a>
                                    </li>
                                }

                                @if (currentPage < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, search })">Sau</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <iconify-icon icon="mingcute:calendar-schedule-line" class="text-muted" style="font-size: 3rem;"></iconify-icon>
                        <h5 class="text-muted mt-3">Không có ca làm việc nào</h5>
                        <p class="text-muted">Hãy tạo ca làm việc đầu tiên để bắt đầu.</p>
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <iconify-icon icon="mingcute:add-line" class="me-1"></iconify-icon>
                            Thêm ca làm việc
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>