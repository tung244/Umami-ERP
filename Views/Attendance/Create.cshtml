@model QuanLiKhoHang.Models.Entities.Attendance

@{
    ViewData["Title"] = "Thêm chấm công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Thêm mới chấm công</h4>
                <p class="card-title-desc">Thêm bản ghi chấm công cho nhân viên</p>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="StaffId" class="form-label">Nhân viên <span class="text-danger">*</span></label>
                                <select asp-for="StaffId" class="form-select" required>
                                    <option value="">-- Chọn nhân viên --</option>
                                    @foreach (var staff in ViewBag.StaffList)
                                    {
                                        <option value="@staff.StaffId">@staff.EmployeeNumber - @staff.FirstName @staff.LastName</option>
                                    }
                                </select>
                                <span asp-validation-for="StaffId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ClockInAt" class="form-label">Thời gian check-in <span class="text-danger">*</span></label>
                                <input asp-for="ClockInAt" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="ClockInAt" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ClockOutAt" class="form-label">Thời gian check-out</label>
                                <input asp-for="ClockOutAt" class="form-control" type="datetime-local" />
                                <span asp-validation-for="ClockOutAt" class="text-danger"></span>
                                <div class="form-text">Để trống nếu nhân viên chưa check-out</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Ghi chú</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Nhập ghi chú nếu có..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="ri-arrow-left-line"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ri-save-line"></i> Lưu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set default check-in time to now
        document.addEventListener('DOMContentLoaded', function() {
            const now = new Date();
            const formatted = now.toISOString().slice(0, 16); // Format for datetime-local
            document.getElementById('CheckInTime').value = formatted;
        });
    </script>
}