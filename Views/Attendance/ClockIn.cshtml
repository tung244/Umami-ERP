@{
    ViewData["Title"] = "Check-in";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title mb-0">
                    <i class="ri-time-line me-2"></i>Check-in làm việc
                </h4>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="text-center mb-4">
                    <div class="avatar-lg mx-auto mb-3">
                        <div class="avatar-title bg-primary rounded-circle">
                            <i class="ri-fingerprint-line font-size-24"></i>
                        </div>
                    </div>
                    <h5>Chào mừng bạn đến với ca làm việc!</h5>
                    <p class="text-muted">Vui lòng chọn thông tin để check-in</p>
                </div>

                <form asp-action="ClockIn" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="staffId" class="form-label">Nhân viên <span class="text-danger">*</span></label>
                        <select name="staffId" class="form-select" id="staffId" required>
                            <option value="">-- Chọn nhân viên --</option>
                            @foreach (var staff in ViewBag.StaffList)
                            {
                                <option value="@staff.StaffId">@staff.EmployeeNumber - @staff.FirstName @staff.LastName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="shiftId" class="form-label">Ca làm việc</label>
                        <select name="shiftId" class="form-select" id="shiftId">
                            <option value="">-- Chọn ca làm việc --</option>
                            @foreach (var shift in ViewBag.ShiftList)
                            {
                                <option value="@shift.ShiftId">@shift.Name (@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="location" class="form-label">Vị trí</label>
                        <input type="text" name="location" class="form-control" id="location" placeholder="Nhập vị trí làm việc">
                    </div>

                    <div class="mb-3">
                        <label for="notes" class="form-label">Ghi chú</label>
                        <textarea name="notes" class="form-control" id="notes" rows="2" placeholder="Nhập ghi chú nếu có..."></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="bg-light p-3 rounded">
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="mb-2">
                                        <i class="ri-calendar-line font-size-20 text-primary"></i>
                                    </div>
                                    <small class="text-muted">Ngày</small>
                                    <div class="fw-bold">@DateTime.Now.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-4">
                                    <div class="mb-2">
                                        <i class="ri-time-line font-size-20 text-success"></i>
                                    </div>
                                    <small class="text-muted">Thời gian</small>
                                    <div class="fw-bold" id="currentTime">@DateTime.Now.ToString("HH:mm:ss")</div>
                                </div>
                                <div class="col-4">
                                    <div class="mb-2">
                                        <i class="ri-map-pin-line font-size-20 text-info"></i>
                                    </div>
                                    <small class="text-muted">Vị trí</small>
                                    <div class="fw-bold">Chi nhánh</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="ri-fingerprint-line me-2"></i>Check-in ngay
                        </button>
                    </div>
                </form>

                <div class="text-center mt-3">
                    <a href="@Url.Action("Index")" class="text-muted">
                        <i class="ri-arrow-left-line"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update current time every second
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('vi-VN', {
                hour12: false,
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            document.getElementById('currentTime').textContent = timeString;
        }

        // Update time immediately and then every second
        updateTime();
        setInterval(updateTime, 1000);
    </script>
}