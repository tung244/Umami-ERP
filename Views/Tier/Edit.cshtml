@model QuanLiKhoHang.Models.Entities.TierConfig

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>@ViewBag.Title</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Loyalty")">Loyalty</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Hạng thành viên</a></li>
                        <li class="breadcrumb-item active">Chỉnh sửa</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8 offset-md-2">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Chỉnh sửa hạng thành viên</h3>
                            <div class="card-tools">
                                <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                                    <i class="fas fa-arrow-left"></i> Quay lại
                                </a>
                            </div>
                        </div>

                        <form method="post" class="needs-validation" novalidate>
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.TierConfigId)
                            @Html.HiddenFor(m => m.Tier)
                            @Html.HiddenFor(m => m.CreatedAt)

                            <div class="card-body">
                                <div class="form-group">
                                    <label>Cấp bậc</label>
                                    <input type="text" class="form-control" value="@Model.Tier.ToString()" disabled />
                                    <small class="text-muted">Không thể thay đổi cấp bậc sau khi tạo</small>
                                </div>

                                <div class="form-group">
                                    <label for="TierName">Tên hiển thị *</label>
                                    <input type="text" class="form-control" id="TierName" name="TierName" 
                                           value="@Model.TierName" required />
                                    @Html.ValidationMessage("TierName", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    <label for="Description">Mô tả</label>
                                    <textarea class="form-control" id="Description" name="Description" rows="2">@Model.Description</textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="MinPoints">Điểm tối thiểu *</label>
                                            <input type="number" class="form-control" id="MinPoints" name="MinPoints" 
                                                   step="0.01" min="0" value="@Model.MinPoints" required />
                                            @Html.ValidationMessage("MinPoints", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="MaxPoints">Điểm tối đa</label>
                                            <input type="number" class="form-control" id="MaxPoints" name="MaxPoints" 
                                                   step="0.01" min="0" value="@Model.MaxPoints" />
                                            <small class="text-muted">Để trống nếu không có giới hạn trên</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label for="Color">Màu hiển thị</label>
                                            <select class="form-control" id="Color" name="Color">
                                                <option value="primary" selected="@(Model.Color == "primary")">Xanh dương (Primary)</option>
                                                <option value="secondary" selected="@(Model.Color == "secondary")">Xám (Secondary)</option>
                                                <option value="success" selected="@(Model.Color == "success")">Xanh lá (Success)</option>
                                                <option value="info" selected="@(Model.Color == "info")">Xanh nhạt (Info)</option>
                                                <option value="warning" selected="@(Model.Color == "warning")">Vàng (Warning)</option>
                                                <option value="danger" selected="@(Model.Color == "danger")">Đỏ (Danger)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4" style="display:none">
                                        <div class="form-group">
                                            <label for="Icon">Icon</label>
                                            <input type="text" class="form-control" id="Icon" name="Icon" 
                                                   value="@Model.Icon" placeholder="fas fa-medal" />
                                            <small class="text-muted">Font Awesome class</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label for="DisplayOrder">Thứ tự hiển thị</label>
                                            <input type="number" class="form-control" id="DisplayOrder" name="DisplayOrder" 
                                                   min="0" value="@Model.DisplayOrder" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive"
                                                   value="true" checked="@Model.IsActive" />
                                            <label class="form-check-label" for="IsActive">
                                                Hạng thành viên đang hoạt động
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Lưu thay đổi
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary ml-2">
                                    <i class="fas fa-times"></i> Hủy bỏ
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}
