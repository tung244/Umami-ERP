@model QuanLiKhoHang.Models.Entities.TierConfig
@using QuanLiKhoHang.Models.Enums
@{
    var availableTiers = ViewBag.AvailableTiers as List<LoyaltyTier>;
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>@ViewBag.Title</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Loyalty")">Loyalty</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Hạng thành viên</a></li>
                        <li class="breadcrumb-item active">Thêm mới</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8 offset-md-2">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Thông tin hạng thành viên</h3>
                            <div class="card-tools">
                                <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                                    <i class="fas fa-arrow-left"></i> Quay lại
                                </a>
                            </div>
                        </div>

                        <form method="post" class="needs-validation" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="Tier">Cấp bậc *</label>
                                            <select class="form-control" id="Tier" name="Tier" required>
                                                <option value="">-- Chọn cấp bậc --</option>
                                                @if (availableTiers != null)
                                                {
                                                    foreach (var tier in availableTiers)
                                                    {
                                                        <option value="@tier">@tier.ToString()</option>
                                                    }
                                                }
                                            </select>
                                            @Html.ValidationMessage("Tier", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="TierName">Tên hiển thị *</label>
                                            <input type="text" class="form-control" id="TierName" name="TierName" 
                                                   placeholder="Ví dụ: Đồng, Bạc, Vàng..." required />
                                            @Html.ValidationMessage("TierName", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="Description">Mô tả</label>
                                    <textarea class="form-control" id="Description" name="Description" rows="2"
                                              placeholder="Mô tả về hạng thành viên..."></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="MinPoints">Điểm tối thiểu *</label>
                                            <input type="number" class="form-control" id="MinPoints" name="MinPoints" 
                                                   step="0.01" min="0" value="0" required />
                                            @Html.ValidationMessage("MinPoints", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="MaxPoints">Điểm tối đa</label>
                                            <input type="number" class="form-control" id="MaxPoints" name="MaxPoints" 
                                                   step="0.01" min="0" placeholder="Để trống nếu không giới hạn" />
                                            <small class="text-muted">Để trống nếu không có giới hạn trên</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label for="Color">Màu hiển thị</label>
                                            <select class="form-control" id="Color" name="Color">
                                                <option value="primary">Xanh dương (Primary)</option>
                                                <option value="secondary">Xám (Secondary)</option>
                                                <option value="success">Xanh lá (Success)</option>
                                                <option value="info">Xanh nhạt (Info)</option>
                                                <option value="warning">Vàng (Warning)</option>
                                                <option value="danger">Đỏ (Danger)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4" style="display:none">
                                        <div class="form-group">
                                            <label for="Icon">Icon</label>
                                            <input type="text" class="form-control" id="Icon" name="Icon" 
                                                   placeholder="fas fa-medal" value="fas fa-medal" />
                                            <small class="text-muted">Font Awesome class</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label for="DisplayOrder">Thứ tự hiển thị</label>
                                            <input type="number" class="form-control" id="DisplayOrder" name="DisplayOrder" 
                                                   min="0" value="0" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive"
                                                   value="true" checked="@(Model?.IsActive ?? true)" />
                                            <label class="form-check-label" for="IsActive">
                                                Hạng thành viên đang hoạt động
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Tạo hạng thành viên
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary ml-2">
                                    <i class="fas fa-times"></i> Hủy bỏ
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}
