@model List<QuanLiKhoHang.Models.Entities.Benefit>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>@ViewBag.Title</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Loyalty")">Loyalty</a></li>
                        <li class="breadcrumb-item active">Quyền lợi</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-gift"></i> Danh sách quyền lợi</h3>
                            <div class="card-tools">
                                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus"></i> Thêm quyền lợi
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (Model != null && Model.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th style="width: 25%;">Tên quyền lợi</th>
                                                <th style="width: 15%;">Loại</th>
                                                <th style="width: 15%;">Giá trị</th>
                                                <th style="width: 25%;">Áp dụng cho hạng</th>
                                                <th style="width: 10%;">Trạng thái</th>
                                                <th style="width: 10%;">Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var benefit in Model)
                                            {
                                                <tr>
                                                    <td>
                                                        <strong><i class="@(benefit.Icon ?? "fas fa-gift")"></i> @benefit.BenefitName</strong>
                                                        @if (!string.IsNullOrEmpty(benefit.Description))
                                                        {
                                                            <br /><small class="text-muted">@benefit.Description</small>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge badge-info" style="color: black">@benefit.BenefitType</span>
                                                    </td>
                                                    <td>
                                                        @if (benefit.DiscountPercent.HasValue)
                                                        {
                                                            <span class="text-success">@benefit.DiscountPercent.Value.ToString("N0")%</span>
                                                        }
                                                        else if (benefit.DiscountAmount.HasValue)
                                                        {
                                                            <span class="text-success">@benefit.DiscountAmount.Value.ToString("N0") VND</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (benefit.TierBenefits != null && benefit.TierBenefits.Any(tb => tb.IsActive))
                                                        {
                                                            @foreach (var tb in benefit.TierBenefits.Where(x => x.IsActive))
                                                            {
                                                                <span class="badge badge-secondary mr-1" style="color: black">@tb.TierConfig?.TierName</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <small class="text-muted" style="color: black">Chưa gán</small>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge badge-@(benefit.IsActive ? "success" : "secondary")" style="color: black">
                                                            @(benefit.IsActive ? "Hoạt động" : "Tắt")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group">
                                                            <a href="@Url.Action("AssignToTier", new { id = benefit.BenefitId })" 
                                                               class="btn btn-info btn-sm" title="Gán cho hạng">
                                                                <i class="fas fa-link"></i>
                                                            </a>
                                                            <a href="@Url.Action("Edit", new { id = benefit.BenefitId })" 
                                                               class="btn btn-warning btn-sm" title="Chỉnh sửa">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            <form method="post" action="@Url.Action("Delete", new { id = benefit.BenefitId })" style="display:inline;"
                                                                  onsubmit="return confirm('Bạn có chắc muốn xóa quyền lợi này? Hành động này không thể hoàn tác!');">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-danger btn-sm" title="Xóa">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-gift fa-3x mb-3"></i>
                                    <p>Chưa có quyền lợi nào</p>
                                    <a href="@Url.Action("Create")" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> Thêm quyền lợi đầu tiên
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
