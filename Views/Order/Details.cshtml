<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script>
var originalBalanceDue = @order.BalanceDue; // Lưu số tiền gốc
var paymentStatusInterval;
// 1. Tạo kết nối đến Hub SignalR
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/paymentHub") // URL này phải khớp với app.MapHub<PaymentHub>("/paymentHub") trong Program.cs
        .configureLogging(signalR.LogLevel.Information)
        .build();

    // 2. Định nghĩa hàm sẽ được gọi khi server gửi tin nhắn "ReceivePaymentStatusUpdate"
    connection.on("ReceivePaymentStatusUpdate", (orderId, status) => {
        const currentOrderId = '@order?.OrderId'; // Lấy OrderId của trang hiện tại
        console.log(`[SignalR] Received update: OrderId=${orderId}, Status=${status}`);
        
        // 3. Kiểm tra xem tin nhắn này có phải dành cho đơn hàng đang hiển thị không
        if (orderId.toLowerCase() === currentOrderId.toLowerCase() && status === 'Received') {
            console.log('[SignalR] Match found! Triggering payment confirmation.');
            
            // Dừng ngay lập tức vòng lặp polling (nếu nó đang chạy)
            if (paymentStatusInterval) {
                clearInterval(paymentStatusInterval);
            }

            // Cập nhật giao diện để báo cho người dùng
            $('#payment-wait-message')
                .html('<i class="fas fa-check-circle text-success"></i> Đã nhận thanh toán! Đang hoàn tất...')
                .removeClass('text-primary').addClass('text-success');

            // Tự động gọi hàm xác nhận thanh toán cuối cùng
            setTimeout(function() {
                confirmQRPayment();
            }, 1000); // Đợi 1s cho người dùng kịp nhìn thấy thông báo
        }
    });

    // 4. Hàm để bắt đầu kết nối (và tự động kết nối lại nếu thất bại)
    async function startSignalRConnection() {
        try {
            await connection.start();
            console.log("[SignalR] Connection established successfully.");
        } catch (err) {
            console.error("[SignalR] Connection failed: ", err);
            // Đợi 5 giây rồi thử kết nối lại
            setTimeout(startSignalRConnection, 5000);
        }
    }

    // Sự kiện xảy ra khi kết nối bị ngắt
    connection.onclose(async () => {
        console.log("[SignalR] Connection closed. Attempting to restart...");
        await startSignalRConnection();
    });

    $(document).ready(function() {
        // Bắt đầu kết nối SignalR ngay khi trang được tải
        startSignalRConnection();

        // Sự kiện đóng modal cũ của bạn vẫn giữ nguyên
        $('#qrPaymentModal').on('hidden.bs.modal', function () {
            console.log('QR Modal đã đóng. Dừng vòng lặp kiểm tra.');
            if (paymentStatusInterval) {
                clearInterval(paymentStatusInterval);
            }
            $('#payment-wait-message').remove();
        });
        
        // ... các sự kiện khác trong document.ready nếu có
    });
// Chọn voucher từ dropdown
function selectVoucherFromDropdown() {
    var selectedCode = $('#voucherDropdown').val();
    if (selectedCode) {
        $('#voucherCodeInput').val(selectedCode);
        // Auto apply
        applyVoucherAtDetail();
    }
}

// Áp dụng quyền lợi khách hàng
function applyBenefit() {
    var selectedValue = $('#benefitDropdown').val().trim();
    
    if (!selectedValue) {
        $('#benefitResultDetail').html('<div class="alert alert-warning alert-sm mt-2">Vui lòng chọn quyền lợi!</div>');
        return;
    }
    
    // Parse value: "Code|DiscountValue|DiscountType"
    var parts = selectedValue.split('|');
    var benefitCode = parts[0];
    var discountValue = parseFloat(parts[1]) || 0;
    var discountType = parts[2];
    
    // Tính tiền giảm
    var discountAmount = 0;
    if (discountType === 'Percentage') {
        discountAmount = Math.round(originalBalanceDue * (discountValue / 100));
    } else {
        discountAmount = discountValue;
    }
    
    // Lưu quyền lợi đã áp dụng
    $('#appliedBenefitCode').val(benefitCode);
    $('#appliedBenefitDiscountAmount').val(discountAmount);
    
    // Hiển thị thành công
    var discountText = discountType === 'Percentage' 
        ? `Giảm ${discountValue}%` 
        : `Giảm ${discountValue.toLocaleString('vi-VN')} VND`;
    
    $('#benefitResultDetail').html(
        '<div class="alert alert-success alert-sm mt-2">' +
        '<i class="fas fa-check-circle"></i> Quyền lợi đã áp dụng: <strong>' + benefitCode + '</strong>' +
        '<br/>' + discountText + ' (tiền: ' + discountAmount.toLocaleString('vi-VN') + ' VND)' +
        '</div>'
    );
    
    // Cập nhật hiển thị giảm giá
    $('#benefitDiscountRow').show();
    $('#benefitDiscountAmount').text(discountAmount.toLocaleString('vi-VN'));
    
    // Tính toán số tiền còn lại (nếu chưa có voucher)
    var voucherDiscount = parseFloat($('#appliedDiscountAmountDetail').val()) || 0;
    var totalDiscount = discountAmount + voucherDiscount;
    var finalAmount = originalBalanceDue - totalDiscount;
    if (finalAmount < 0) finalAmount = 0;
    
    // Cập nhật số tiền còn lại
    $('#balanceDueAmount').text(finalAmount.toLocaleString('vi-VN'))
        .removeClass('text-danger').addClass('text-success');
    
    // Cập nhật button "Thanh toán QR"
    $('#qrPaymentButtonText').text('Thanh toán QR (' + finalAmount.toLocaleString('vi-VN') + ' VND)');
    
    // Disable dropdown và đổi button thành "Hủy"
    $('#benefitDropdown').prop('disabled', true);
    $('#applyBenefitBtn').html('<i class="fas fa-times"></i> Hủy')
        .removeClass('btn-success').addClass('btn-secondary')
        .attr('onclick', 'removeBenefit()');
}

// Hủy quyền lợi
function removeBenefit() {
    // Reset quyền lợi
    $('#benefitDropdown').val('').prop('disabled', false);
    $('#appliedBenefitCode').val('');
    $('#appliedBenefitDiscountAmount').val('0');
    $('#benefitResultDetail').html('');
    $('#benefitDiscountRow').hide();
    
    // Tính toán lại số tiền (chỉ dựa trên voucher nếu có)
    var voucherDiscount = parseFloat($('#appliedDiscountAmountDetail').val()) || 0;
    var finalAmount = originalBalanceDue - voucherDiscount;
    if (finalAmount < 0) finalAmount = 0;
    
    // Cập nhật số tiền còn lại
    $('#balanceDueAmount').text(finalAmount.toLocaleString('vi-VN'))
        .removeClass('text-success').addClass(finalAmount > 0 ? 'text-danger' : 'text-success');
    
    // Reset button "Thanh toán QR"
    $('#qrPaymentButtonText').text('Thanh toán QR (' + finalAmount.toLocaleString('vi-VN') + ' VND)');
    
    // Reset button Áp dụng
    $('#applyBenefitBtn').html('<i class="fas fa-check"></i> Áp dụng')
        .removeClass('btn-secondary').addClass('btn-success')
        .attr('onclick', 'applyBenefit()');
}

// Chọn voucher từ dropdown
function selectVoucherFromDropdown() {
    var selectedCode = $('#voucherDropdown').val();
    if (selectedCode) {
        $('#voucherCodeInput').val(selectedCode);
        // Auto apply
        applyVoucherAtDetail();
    }
}

// Áp dụng voucher NGAY TẠI trang Detail
function applyVoucherAtDetail() {
    var voucherCode = $('#voucherCodeInput').val().trim();
    
    if (!voucherCode) {
        $('#voucherResultDetail').html('<div class="alert alert-warning alert-sm mt-2">Vui lòng nhập mã voucher!</div>');
        return;
    }
    
    // Disable button
    $('#applyVoucherBtnDetail').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Đang kiểm tra...');
    
    $.ajax({
        url: '@Url.Action("ValidateVoucher", "Voucher")',
        type: 'POST',
        data: {
            code: voucherCode,
            orderAmount: originalBalanceDue
        },
        success: function(response) {
            if (response.success) {
                // Show success
                $('#voucherResultDetail').html(
                    '<div class="alert alert-success alert-sm mt-2">' +
                    '<i class="fas fa-check-circle"></i> ' + response.message + 
                    '<br/><strong>' + response.discountInfo + '</strong>' +
                    '</div>'
                );
                
                // Lưu voucher đã áp dụng
                $('#appliedVoucherCodeDetail').val(response.voucherCode);
                $('#appliedDiscountAmountDetail').val(response.discountAmount);
                
                // Cập nhật hiển thị
                $('#voucherDiscountAmount').text(response.discountAmount.toLocaleString('vi-VN'));
                $('#voucherDiscountRow').show();
                
                // Tính toán lại số tiền còn lại (bao gồm benefit nếu có)
                var benefitDiscount = parseFloat($('#appliedBenefitDiscountAmount').val()) || 0;
                var totalDiscount = response.discountAmount + benefitDiscount;
                var finalAmount = originalBalanceDue - totalDiscount;
                if (finalAmount < 0) finalAmount = 0;
                
                // Cập nhật số tiền còn lại
                $('#balanceDueAmount').text(finalAmount.toLocaleString('vi-VN'))
                    .removeClass('text-danger').addClass('text-success');
                
                // Cập nhật button "Thanh toán QR"
                $('#qrPaymentButtonText').text('Thanh toán QR (' + finalAmount.toLocaleString('vi-VN') + ' VND)');
                
                // Disable input, dropdown và đổi button thành "Hủy"
                $('#voucherCodeInput').prop('disabled', true);
                $('#voucherDropdown').prop('disabled', true);
                $('#applyVoucherBtnDetail').html('<i class="fas fa-times"></i> Hủy')
                    .removeClass('btn-warning').addClass('btn-secondary')
                    .attr('onclick', 'removeVoucherAtDetail()').prop('disabled', false);
            } else {
                $('#voucherResultDetail').html(
                    '<div class="alert alert-danger alert-sm mt-2">' +
                    '<i class="fas fa-times-circle"></i> ' + response.message +
                    '</div>'
                );
                $('#applyVoucherBtnDetail').html('<i class="fas fa-check"></i> Áp dụng').prop('disabled', false);
            }
        },
        error: function() {
            $('#voucherResultDetail').html('<div class="alert alert-danger alert-sm mt-2">Lỗi kết nối! Vui lòng thử lại.</div>');
            $('#applyVoucherBtnDetail').html('<i class="fas fa-check"></i> Áp dụng').prop('disabled', false);
        }
    });
}

// Hủy voucher
function removeVoucherAtDetail() {
    // Reset voucher
    $('#voucherCodeInput').val('').prop('disabled', false);
    $('#voucherDropdown').val('').prop('disabled', false); // Reset dropdown
    $('#appliedVoucherCodeDetail').val('');
    $('#appliedDiscountAmountDetail').val('0');
    $('#voucherResultDetail').html('');
    $('#voucherDiscountRow').hide();
    
    // Tính lại số tiền (chỉ dựa trên benefit nếu có)
    var benefitDiscount = parseFloat($('#appliedBenefitDiscountAmount').val()) || 0;
    var finalAmount = originalBalanceDue - benefitDiscount;
    if (finalAmount < 0) finalAmount = 0;
    
    // Cập nhật số tiền
    $('#balanceDueAmount').text(finalAmount.toLocaleString('vi-VN'))
        .removeClass('text-success').addClass(finalAmount > 0 ? 'text-danger' : 'text-success');
    
    // Reset button "Thanh toán QR"
    $('#qrPaymentButtonText').text('Thanh toán QR (' + finalAmount.toLocaleString('vi-VN') + ' VND)');
    
    // Reset button Áp dụng
    $('#applyVoucherBtnDetail').html('<i class="fas fa-check"></i> Áp dụng')
        .removeClass('btn-secondary').addClass('btn-warning')
        .attr('onclick', 'applyVoucherAtDetail()');
}

function getAntiForgeryToken() {
    return $('input[name="__RequestVerificationToken"]').val();
}

function showAddItemModal() {
    $('#addItemModal').modal('show');
}

function showCheckoutModal() {
    $('#checkoutModal').modal('show');
}

function removeItem(orderItemId) {
    if (confirm('Bạn có chắc muốn xóa món ăn này?')) {
        $.ajax({
            url: '@Url.Action("RemoveItem", "Order")',
            type: 'POST',
            data: {
                orderId: '@order.OrderId',
                orderItemId: orderItemId,
                __RequestVerificationToken: getAntiForgeryToken()
            },
            success: function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + response.message);
                }
            },
            error: function() {
                alert('Có lỗi xảy ra khi xóa món ăn!');
            }
        });
    }
}

function increaseQuantity(orderItemId) {
    var currentInput = $('.qty-' + orderItemId);
    var currentQty = parseInt(currentInput.val());
    updateQuantity(orderItemId, currentQty + 1);
}

function decreaseQuantity(orderItemId) {
    var currentInput = $('.qty-' + orderItemId);
    var currentQty = parseInt(currentInput.val());
    if (currentQty > 1) {
        updateQuantity(orderItemId, currentQty - 1);
    } else {
        alert('Số lượng phải lớn hơn 1!');
    }
}

function updateQuantity(orderItemId, newQuantity) {
    if (newQuantity < 1) {
        alert('Số lượng phải lớn hơn 0!');
        return;
    }

    $.ajax({
        url: '@Url.Action("UpdateItemQuantity", "Order")',
        type: 'POST',
        data: {
            orderId: '@order.OrderId',
            orderItemId: orderItemId,
            newQuantity: newQuantity,
            __RequestVerificationToken: getAntiForgeryToken()
        },
        success: function(response) {
            if (response.success) {
                location.reload();
            } else {
                alert('Lỗi: ' + response.message);
            }
        },
        error: function() {
            alert('Có lỗi xảy ra khi cập nhật số lượng!');
        }
    });
}

function deleteOrder(orderId) {
    if (confirm('Bạn có chắc muốn hủy đơn hàng này?')) {
        $.ajax({
            url: '@Url.Action("Delete", "Order")',
            type: 'POST',
            data: { 
                orderId: orderId,
                __RequestVerificationToken: getAntiForgeryToken()
            },
            success: function(response) {
                if (response.success) {
                    alert(response.message);
                    window.location.href = '@Url.Action("Index", "Order")';
                } else {
                    alert('Lỗi: ' + response.message);
                }
            },
            error: function() {
                alert('Có lỗi xảy ra khi hủy đơn hàng!');
            }
        });
    }
}

function applyVoucher() {
    var voucherCode = $('#voucherCode').val().trim();
    var originalAmount = @order?.BalanceDue;
    
    if (!voucherCode) {
        $('#voucherResult').html('<div class="alert alert-warning alert-sm">Vui lòng nhập mã voucher!</div>').show();
        return;
    }
    
    // Disable button
    $('#applyVoucherBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm mr-1"></span>Đang kiểm tra...');
    
    $.ajax({
        url: '@Url.Action("ValidateVoucher", "Voucher")',
        type: 'POST',
        data: {
            code: voucherCode,
            orderAmount: originalAmount
        },
        success: function(response) {
            if (response.success) {
                // Show success
                $('#voucherResult').html('<div class="alert alert-success alert-sm"><i class="fas fa-check-circle"></i> ' + response.message + '<br/><strong>' + response.discountInfo + '</strong></div>').show();
                
                // Update amounts
                $('#appliedVoucherCode').val(response.voucherCode);
                $('#appliedDiscountAmount').val(response.discountAmount);
                
                // Show original amount
                $('#originalAmount').show();
                
                // Show discount info
                $('#discountInfo').html('<h6><i class="fas fa-tag"></i> Giảm giá: -' + response.discountAmount.toLocaleString('vi-VN') + ' VND</h6>').show();
                
                // Update final amount
                $('#qr-amount').text(response.finalAmount.toLocaleString('vi-VN'));
                
                // Disable voucher input
                $('#voucherCode').prop('disabled', true);
                $('#applyVoucherBtn').html('<i class="fas fa-times"></i> Hủy').attr('onclick', 'removeVoucher()').prop('disabled', false);
            } else {
                $('#voucherResult').html('<div class="alert alert-danger alert-sm"><i class="fas fa-times-circle"></i> ' + response.message + '</div>').show();
                $('#applyVoucherBtn').html('<i class="fas fa-check"></i> Áp dụng').prop('disabled', false);
            }
        },
        error: function() {
            $('#voucherResult').html('<div class="alert alert-danger alert-sm">Lỗi kết nối! Vui lòng thử lại.</div>').show();
            $('#applyVoucherBtn').html('<i class="fas fa-check"></i> Áp dụng').prop('disabled', false);
        }
    });
}

function removeVoucher() {
    var originalAmount = @order?.BalanceDue;
    
    // Reset
    $('#voucherCode').val('').prop('disabled', false);
    $('#appliedVoucherCode').val('');
    $('#appliedDiscountAmount').val('0');
    $('#voucherResult').hide();
    $('#originalAmount').hide();
    $('#discountInfo').hide();
    $('#qr-amount').text(originalAmount.toLocaleString('vi-VN'));
    $('#applyVoucherBtn').html('<i class="fas fa-check"></i> Áp dụng').attr('onclick', 'applyVoucher()');
}

function showQRPaymentModal() {
    // Lấy discount từ benefit và voucher
    var benefitDiscount = parseFloat($('#appliedBenefitDiscountAmount').val()) || 0;
    var voucherDiscount = parseFloat($('#appliedDiscountAmountDetail').val()) || 0;
    var totalDiscount = benefitDiscount + voucherDiscount;
    var finalAmount = originalBalanceDue - totalDiscount;
    if (finalAmount < 0) finalAmount = 0;
    
    console.log('Opening QR Modal - Benefit:', benefitDiscount, 'Voucher:', voucherDiscount, 'Final:', finalAmount);
    
    // Copy discount vào modal
    if (benefitDiscount > 0) {
        $('#discountInfo').html('Quyền lợi giảm: -' + benefitDiscount.toLocaleString('vi-VN') + ' VND').show();
    }
    
    if (voucherDiscount > 0) {
        var voucherCode = $('#appliedVoucherCodeDetail').val();
        $('#voucherCode').val(voucherCode).prop('disabled', true);
        $('#voucherResult').html(
            '<div class="alert alert-success alert-sm">' +
            '<i class="fas fa-check-circle"></i> Đã áp dụng voucher: <strong>' + voucherCode + '</strong>' +
            '<br/>Giảm: ' + voucherDiscount.toLocaleString('vi-VN') + ' VND' +
            '</div>'
        ).show();
        $('#applyVoucherBtn').html('<i class="fas fa-times"></i> Hủy').attr('onclick', 'removeVoucher()');
    }
    
    $('#qr-amount').text(finalAmount.toLocaleString('vi-VN'));
    
    $('#qrPaymentModal').modal('show');
    $('#confirmPaymentBtn').hide(); 
    $('#qr-code-wrapper').after('<p id="payment-wait-message" class="text-center text-primary mt-3 font-weight-bold" style="font-size: 1.1rem;"><i class="fas fa-sync fa-spin"></i> Đang chờ khách hàng thanh toán...</p>');
    
    // Gọi API để lấy QR code với số tiền đã giảm
    $.ajax({
        url: '@Url.Action("GenerateQRPayment", "Order")',
        type: 'GET',
        data: { 
            orderId: '@order?.OrderId',
            amount: finalAmount  // Gửi số tiền đã giảm
        },
        success: function(data) {
            // Hiển thị QR code
            $('#qr-loading').hide();
            $('#qr-code-image').attr('src', data.qrUrl).show();
            startPaymentStatusChecker(); 
        },
        error: function() {
            $('#qr-loading').html('<p class="text-danger">Không thể tạo mã QR. Vui lòng thử lại.</p>');
        }
    });
}
$(document).ready(function() {
    // Sự kiện được kích hoạt KHI modal ĐÃ ĐƯỢC ĐÓNG HOÀN TOÀN
    $('#qrPaymentModal').on('hidden.bs.modal', function () {
        console.log('QR Modal đã đóng. Dừng vòng lặp kiểm tra.');
        if (paymentStatusInterval) {
            clearInterval(paymentStatusInterval);
        }
        // Xóa thông báo chờ để lần mở sau không bị hiện lại
        $('#payment-wait-message').remove();
    });
});

function startPaymentStatusChecker() {
    const orderId = '@order?.OrderId';

    // Dừng các vòng lặp cũ (nếu có) để đảm bảo chỉ có 1 vòng lặp chạy
    if (paymentStatusInterval) {
        clearInterval(paymentStatusInterval);
    }
    
    paymentStatusInterval = setInterval(function() {
        $.ajax({
            url: '@Url.Action("CheckPaymentStatus", "Order")',
            type: 'GET',
            data: { orderId: orderId },
            success: function(response) {
                console.log('Checking payment status...', response.paymentStatus);
                
                if (response.paymentStatus === 'Received') {
                    // DỪNG VÒNG LẶP
                    clearInterval(paymentStatusInterval);
                    
                    // Cập nhật giao diện để thông báo đã nhận tiền
                    $('#payment-wait-message')
                        .html('<i class="fas fa-check-circle text-success"></i> Đã nhận được thanh toán! Đang hoàn tất giao dịch...')
                        .removeClass('text-primary').addClass('text-success');
                    
                    // TỰ ĐỘNG GỌI HÀM HOÀN TẤT THANH TOÁN
                    setTimeout(function() {
                        confirmQRPayment(); 
                    }, 1000); // Đợi 1 giây cho đẹp
                }
            },
            error: function() {
                console.error("Lỗi khi kiểm tra trạng thái. Dừng lại.");
                clearInterval(paymentStatusInterval);
            }
        });
    }, 3000); // Lặp lại mỗi 3 giây
}

function confirmQRPayment() {
    // Hiển thị loading
    $('#confirmPaymentBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm mr-2"></span>Đang xử lý...');
    
    var orderId = '@order?.OrderId';
    var token = $('input[name="__RequestVerificationToken"]').val();
    
    // Lấy benefit và voucher từ Detail page
    var benefitDiscount = parseFloat($('#appliedBenefitDiscountAmount').val()) || 0;
    var voucherCode = $('#appliedVoucherCodeDetail').val();
    var voucherDiscount = parseFloat($('#appliedDiscountAmountDetail').val()) || 0;
    var totalDiscount = benefitDiscount + voucherDiscount;
    
    console.log('=== PAYMENT DEBUG START ===');
    console.log('Order ID:', orderId);
    console.log('Token:', token);
    console.log('Benefit Discount:', benefitDiscount);
    console.log('Voucher Code:', voucherCode);
    console.log('Voucher Discount:', voucherDiscount);
    console.log('Total Discount:', totalDiscount);
    console.log('Token exists:', token ? 'YES' : 'NO');
    console.log('URL:', '@Url.Action("CheckoutQR", "Order")');
    
    // Gọi API xác nhận thanh toán
    $.ajax({
        url: '@Url.Action("CheckoutQR", "Order")',
        type: 'POST',
        data: {
            orderId: orderId,
            voucherCode: voucherCode,
            discountAmount: totalDiscount,  // Gửi tổng discount (benefit + voucher)
            __RequestVerificationToken: token
        },
        success: function(response) {
            console.log('=== PAYMENT SUCCESS ===');
            console.log('Response:', response);
            console.log('Success status:', response.success);
            
            // Alert để debug
            alert('Thanh toán thành công!\nOrder: ' + (response.orderNumber || '@order?.OrderNumber'));
            
            // Đóng modal QR
            $('#qrPaymentModal').modal('hide');
            
            // Hiển thị modal cảm ơn với hiệu ứng
            $('#thank-you-order-number').text(response.orderNumber || '@order?.OrderNumber');
            $('#thankYouModal').modal('show');
            
            // Tạo hiệu ứng confetti
            createConfetti();
            
        },
        error: function(xhr, status, error) {
            console.log('=== PAYMENT ERROR ===');
            console.error('XHR:', xhr);
            console.error('Status:', status);
            console.error('Error:', error);
            console.error('Response Text:', xhr.responseText);
            
            // Alert để debug
            alert('LỖI THANH TOÁN!\nStatus: ' + status + '\nError: ' + error + '\n\nXem Console (F12) để biết chi tiết');
            
            // Ngay cả khi có lỗi, vẫn coi là thành công (theo yêu cầu)
            $('#qrPaymentModal').modal('hide');
            $('#thank-you-order-number').text('@order?.OrderNumber');
            $('#thankYouModal').modal('show');
            createConfetti();
            
        }
    });
}

function closeThankYou() {
    $('#thankYouModal').modal('hide');
    window.location.href = '@Url.Action("Index", "TableManagement")';
}

function createConfetti() {
    // Tạo hiệu ứng pháo hoa đơn giản
    const duration = 3000;
    const animationEnd = Date.now() + duration;
    const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 10000 };

    function randomInRange(min, max) {
        return Math.random() * (max - min) + min;
    }

    const interval = setInterval(function() {
        const timeLeft = animationEnd - Date.now();

        if (timeLeft <= 0) {
            return clearInterval(interval);
        }

        const particleCount = 50 * (timeLeft / duration);

        // Create confetti particles
        for(let i = 0; i < 5; i++) {
            const particle = document.createElement('div');
            particle.style.position = 'fixed';
            particle.style.width = '10px';
            particle.style.height = '10px';
            particle.style.backgroundColor = ['#667eea', '#764ba2', '#f093fb', '#f5576c', '#48bb78'][Math.floor(Math.random() * 5)];
            particle.style.left = Math.random() * window.innerWidth + 'px';
            particle.style.top = '-10px';
            particle.style.borderRadius = '50%';
            particle.style.zIndex = '9999';
            particle.style.pointerEvents = 'none';
            
            document.body.appendChild(particle);
            
            const fall = particle.animate([
                { transform: 'translateY(0) rotate(0deg)', opacity: 1 },
                { transform: `translateY(${window.innerHeight}px) rotate(${Math.random() * 360}deg)`, opacity: 0 }
            ], {
                duration: 2000 + Math.random() * 1000,
                easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)'
            });
            
            fall.onfinish = () => particle.remove();
        }
    }, 250);
}

$('#paidAmount').on('input', function() {
    var paid = parseFloat($(this).val()) || 0;
    var total = @(order?.BalanceDue ?? 0);
    var change = paid - total;
    $('#changeAmount').text(change >= 0 ? change.toLocaleString() + ' VND' : 'Không đủ tiền');
    $('#changeAmount').removeClass('text-success text-danger');
    $('#changeAmount').addClass(change >= 0 ? 'text-success' : 'text-danger');
});
