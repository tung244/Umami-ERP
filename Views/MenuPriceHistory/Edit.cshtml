@using QuanLiKhoHang.Models.Entities
@{
    var item = ViewBag.Item as MenuPriceHistory;
    var staffList = ViewBag.StaffList as List<Staff>;
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="ri-edit-line me-2"></i>@ViewBag.Title</h5>
    </div>
    <div class="card-body">
        @if (item != null)
        {
            <div class="alert alert-warning mb-4">
                <i class="ri-information-line me-2"></i>
                <strong>Lưu ý:</strong> Chỉnh sửa lịch sử giá có thể ảnh hưởng đến báo cáo. Hãy cẩn thận khi thực hiện!
            </div>

            <div class="alert alert-info mb-4">
                <h6 class="alert-heading">Thông tin món ăn</h6>
                <p class="mb-0">
                    <strong>Món:</strong> @item.Dish?.Name (@(item.Dish?.Sku ?? "N/A"))<br/>
                    <strong>Giá hiện tại trong record:</strong> <span class="text-primary fw-bold">@item.Price.ToString("N0") VND</span>
                </p>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.MenuPriceId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="price" class="form-label required">Giá (VND)</label>
                            <input type="number" step="1" id="price" name="price" 
                                   class="form-control" value="@item.Price" min="0" required />
                        </div>

                        <div class="mb-3">
                            <label for="effectiveFrom" class="form-label required">Hiệu lực từ</label>
                            <input type="datetime-local" id="effectiveFrom" name="effectiveFrom" 
                                   class="form-control" value="@item.EffectiveFrom.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>

                        <div class="mb-3">
                            <label for="effectiveTo" class="form-label">Hiệu lực đến</label>
                            <input type="datetime-local" id="effectiveTo" name="effectiveTo" 
                                   class="form-control" value="@item.EffectiveTo?.ToString("yyyy-MM-ddTHH:mm")" />
                            <small class="form-text text-muted">Để trống nếu đây là giá hiện tại</small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="changedByStaffId" class="form-label">Người thay đổi</label>
                            <select id="changedByStaffId" name="changedByStaffId" class="form-select">
                                <option value="">-- Không chọn --</option>
                                @if (staffList != null)
                                {
                                    @foreach (var staff in staffList)
                                    {
                                        <option value="@staff.StaffId" 
                                                selected="@(item.ChangedByStaffId == staff.StaffId)">
                                            @staff.FirstName @staff.LastName
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="reason" class="form-label">Lý do thay đổi</label>
                            <textarea id="reason" name="reason" class="form-control" rows="5" 
                                      placeholder="Nhập lý do thay đổi giá...">@item.Reason</textarea>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-save-line me-1"></i>Lưu thay đổi
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="ri-arrow-left-line me-1"></i>Hủy
                    </a>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-danger">
                <i class="ri-error-warning-line me-2"></i>Không tìm thấy lịch sử giá!
            </div>
        }
    </div>
</div>
