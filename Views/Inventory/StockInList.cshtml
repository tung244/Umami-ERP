@using QuanLiKhoHang.Models.Entities
@{
    var items = ViewBag.Items as List<InventoryItem>;
    int page = (int)ViewBag.CurrentPage;
    int total = (int)ViewBag.TotalPages;
    string search = (string)ViewBag.SearchTerm;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">@ViewBag.Title</h4>
                <div class="card-tools">
                    <a href="@Url.Action("Index", "Inventory")" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>

            <div class="card-body">
                <form method="get" class="mb-3">
                    <div class="row">
                        <div class="col-md-6">
                            <input type="text" name="search" value="@search" class="form-control" placeholder="Tìm kiếm vật phẩm..." />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-secondary btn-block">
                                <i class="fas fa-search"></i> Tìm kiếm
                            </button>
                        </div>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Mã SKU</th>
                                <th>Tên vật phẩm</th>
                                <th>Vị trí lưu trữ</th>
                                <th>Đơn vị</th>
                                <th>Giá nhập</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (items != null && items.Any())
                            {
                                @foreach (var item in items)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrEmpty(item.Sku) ? "-" : item.Sku)</td>
                                        <td>
                                            <strong>@item.Name</strong>
                                        </td>
                                        <td>@(item.StorageLocation?.Name ?? "-")</td>
                                        <td>@item.Unit</td>
                                        <td>@string.Format("{0:N0}", item.CostPerUnit) VND</td>
                                        <td>
                                            <a href="@Url.Action("StockIn", new { id = item.ItemId })" class="btn btn-sm btn-success">
                                                <i class="fas fa-arrow-down me-1"></i>Nhập
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2"></i>
                                        <br />
                                        Không có vật phẩm nào
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (total > 1)
                {
                    <div class="d-flex justify-content-center">
                        <nav aria-label="Page navigation">
                            <ul class="pagination">
                                @if (page > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("StockInList", new { page = page - 1, search })">Trước</a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, page - 2); i <= Math.Min(total, page + 2); i++)
                                {
                                    <li class="page-item @(i == page ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("StockInList", new { page = i, search })">@i</a>
                                    </li>
                                }

                                @if (page < total)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("StockInList", new { page = page + 1, search })">Sau</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
