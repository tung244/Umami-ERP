@using QuanLiKhoHang.Models.Entities
@model DishIngredient

<form method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.DishIngredientId)
    @Html.HiddenFor(m => m.DishId)
    @Html.HiddenFor(m => m.InventoryItemId)
    @Html.HiddenFor(m => m.CreatedAt)

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Thông tin</h5>
            <p class="card-text">
                <strong>Món ăn:</strong> @Model.Dish?.Name<br />
                <strong>Nguyên liệu:</strong> @Model.InventoryItem?.Name (@Model.InventoryItem?.Unit)
            </p>
        </div>
    </div>

    <div class="mb-3">
        <label for="quantityPerPortion" class="form-label">Số lượng trên 1 portion</label>
        <input type="number" step="0.01" id="quantityPerPortion" name="quantityPerPortion" class="form-control" value="@Model.QuantityPerPortion" required />
    </div>

    <div class="mb-3 form-check">
        <input type="checkbox" id="isOptional" name="isOptional" class="form-check-input" @(Model.IsOptional ? "checked" : "") />
        <label for="isOptional" class="form-check-label">Là nguyên liệu tùy chọn</label>
    </div>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a href="@Url.Action("Index", new { dishId = Model.DishId })" class="btn btn-secondary">Hủy</a>
</form>