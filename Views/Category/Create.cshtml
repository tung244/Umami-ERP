@using QuanLiKhoHang.Models.Entities
@model Category
@{
    var parentCategories = ViewBag.ParentCategories as List<Category>;
}

<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="Name" class="form-label">Tên danh mục</label>
        <input type="text" id="Name" name="Name" class="form-control" required />
        @Html.ValidationMessageFor(m => m.Name)
    </div>
    <div class="mb-3">
        <label for="Description" class="form-label">Mô tả</label>
        <textarea id="Description" name="Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label for="ParentCategoryId" class="form-label">Danh mục cha</label>
        <select id="ParentCategoryId" name="ParentCategoryId" class="form-select">
            <option value="">Không có</option>
            @if (parentCategories != null)
            {
                @foreach (var cat in parentCategories)
                {
                    <option value="@cat.CategoryId">@cat.Name</option>
                }
            }
        </select>
    </div>
    <div class="mb-3">
        <label for="DisplayOrder" class="form-label">Thứ tự hiển thị</label>
        <input type="number" id="DisplayOrder" name="DisplayOrder" class="form-control" />
    </div>
    <div class="mb-3 form-check">
        <input type="checkbox" id="Active" name="Active" class="form-check-input" checked />
        <label for="Active" class="form-check-label">Hoạt động</label>
    </div>
    <button type="submit" class="btn btn-primary">Tạo</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
</form>