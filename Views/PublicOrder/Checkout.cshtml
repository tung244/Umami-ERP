@using QuanLiKhoHang.Models.Entities
@{
    Layout = "~/Views/Shared/_LayoutOrder.cshtml";
    var table = ViewBag.Table as RestaurantTable;
    var cartItems = ViewBag.CartItems as IEnumerable<dynamic>;
    var totalAmount = ViewBag.TotalAmount as decimal?;
}
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="menu-card p-4">
                <!-- Header -->
                <div class="text-center mb-4">
                    <h2 class="h4 mb-2">
                        <i class="ri-checkbox-circle-line text-success me-2"></i>
                        Xác nhận đơn hàng
                    </h2>
                    <p class="text-muted">Vui lòng kiểm tra lại đơn hàng và nhập thông tin liên hệ</p>
                </div>

                <!-- Table Info -->
                <div class="table-info mb-4">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <i class="ri-chair-line fa-2x mb-2"></i>
                            <div>
                                <strong>Bàn:</strong> @table?.Name
                            </div>
                        </div>
                        <div class="col-md-4">
                            <i class="ri-group-line fa-2x mb-2"></i>
                            <div>
                                <strong>Sức chứa:</strong> @table?.Seats người
                            </div>
                        </div>
                        <div class="col-md-4">
                            <i class="ri-time-line fa-2x mb-2"></i>
                            <div>
                                <strong>Thời gian:</strong> @DateTime.Now.ToString("HH:mm dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                </div>

                    <div class="row">
                        <!-- Order Summary -->
                        <div class="col-md-8">
                            <div class="order-summary">
                                <h5 class="mb-3">
                                    <i class="ri-list-check text-primary me-2"></i>
                                    Chi tiết đơn hàng
                                </h5>

                                <div class="table-responsive">
                                    <table class="table table-borderless">
                                        <thead>
                                            <tr class="text-muted">
                                                <th>Món ăn</th>
                                                <th class="text-center">SL</th>
                                                <th class="text-end">Đơn giá</th>
                                                <th class="text-end">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in cartItems ?? new List<dynamic>())
                                            {
                                                <tr>
                                                    <td>
                                                        <strong>@item.Dish.Name</strong>
                                                        @if (!string.IsNullOrEmpty(item.Dish.Description))
                                                        {
                                                            <br><small class="text-muted">@item.Dish.Description</small>
                                                        }
                                                    </td>
                                                    <td class="text-center">@item.Quantity</td>
                                                    <td class="text-end">@item.Dish.DefaultServingPrice.ToString("N0")₫</td>
                                                    <td class="text-end fw-bold">@item.Total.ToString("N0")₫</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="border-top">
                                                <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                                                <td class="text-end fw-bold text-primary fs-5">@totalAmount?.ToString("N0")₫</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Customer Info Form -->
                        <div class="col-md-4">
                            <div class="bg-light rounded p-3">
                                <h5 class="mb-3">
                                    <i class="ri-user-line text-primary me-2"></i>
                                    Thông tin khách hàng
                                </h5>

                                <form id="checkoutForm">
                                    <input type="hidden" name="tableId" value="@table?.TableId" />

                                    @* Include cart items data for validation *@
                                    @foreach (var item in cartItems ?? new List<dynamic>())
                                    {
                                        <input type="hidden" name="cartItems[@item.Dish.DishId].dishId" value="@item.Dish.DishId" />
                                        <input type="hidden" name="cartItems[@item.Dish.DishId].quantity" value="@item.Quantity" />
                                        <input type="hidden" name="cartItems[@item.Dish.DishId].unitPrice" value="@item.Dish.DefaultServingPrice" />
                                    }

                                    <div class="mb-3">
                                        <label for="customerPhone" class="form-label">
                                            <i class="ri-phone-line me-1"></i>
                                            Số điện thoại <span class="text-danger">*</span>
                                        </label>
                                        <input type="tel" class="form-control" id="customerPhone" name="customerPhone"
                                               placeholder="Nhập số điện thoại" required
                                               pattern="[0-9]{10,11}" maxlength="11">
                                        <div class="form-text">Sẽ dùng để liên hệ và xác nhận đơn hàng</div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="customerName" class="form-label">
                                            <i class="ri-user-line me-1"></i>
                                            Tên khách hàng (tùy chọn)
                                        </label>
                                        <input type="text" class="form-control" id="customerName" name="customerName"
                                               placeholder="Nhập tên của bạn">
                                    </div>

                                    <div class="mb-3 form-check">
                                        <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                                        <label class="form-check-label" for="agreeTerms">
                                            Tôi đồng ý với <a href="#" class="text-primary">điều khoản sử dụng</a>
                                        </label>
                                    </div>

                                    <button type="submit" class="btn btn-checkout w-100" id="confirmBtn">
                                        <i class="ri-checkbox-circle-line me-2"></i>
                                        Xác nhận đặt hàng
                                    </button>
                                </form>

                                <div class="mt-3 text-center">
                                    <button class="btn btn-outline-secondary btn-sm" onclick="goBack()">
                                        <i class="ri-arrow-left-line me-1"></i>
                                        Quay lại menu
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="ri-check-circle-line me-2"></i>
                        Đặt hàng thành công!
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <i class="ri-check-circle-line fa-4x text-success mb-3"></i>
                    <h4 id="orderMessage"></h4>
                    <p class="text-muted">Đơn hàng của bạn đã được gửi đến bếp. Vui lòng chờ nhân viên phục vụ.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="viewOrderStatus()">
                        <i class="ri-eye-line me-1"></i>
                        Xem trạng thái đơn hàng
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="ri-restaurant-line me-1"></i>
                        Tiếp tục gọi món
                    </button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        // Form submission
        $('#checkoutForm').on('submit', function(e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = {
                tableId: formData.get('tableId'),
                customerPhone: formData.get('customerPhone'),
                customerName: formData.get('customerName')
            };

            $('#confirmBtn').prop('disabled', true).html('<i class="ri-loader-4-line ri-spin me-2"></i>Đang xử lý...');

            $.ajax({
                url: '/PublicOrder/ConfirmOrder',
                type: 'POST',
                data: data,
                success: function(response) {
                    if (response.success) {
                        $('#orderMessage').text(response.message);
                        $('#successModal').modal('show');
                    } else {
                        showAlert(response.message, 'danger');
                    }
                },
                error: function() {
                    showAlert('Có lỗi xảy ra khi đặt hàng. Vui lòng thử lại!', 'danger');
                },
                complete: function() {
                    $('#confirmBtn').prop('disabled', false).html('<i class="ri-checkbox-circle-line me-2"></i>Xác nhận đặt hàng');
                }
            });
        });

        // Go back to menu
        function goBack() {
            const fallbackUrl = '@Url.Action("Notes", "Dish")';
            const tableUrl = '@(table != null ? Url.Action("Index", "PublicOrder", new { tableId = table.TableId }) : string.Empty)';
            window.location.href = tableUrl || fallbackUrl;
        }

        // View order status (placeholder)
        function viewOrderStatus() {
            // This would redirect to order status page
            alert('Tính năng xem trạng thái đơn hàng sẽ được phát triển sau!');
        }

        // Show alert
        function showAlert(message, type) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('.checkout-card').prepend(alertHtml);
        }

        // Phone number validation
        $('#customerPhone').on('input', function() {
            const phone = $(this).val().replace(/\D/g, '');
            $(this).val(phone);
        });
    </script>
}