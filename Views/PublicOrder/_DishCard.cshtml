@using QuanLiKhoHang.Models.Entities
@model Dish

<div class="card dish-card h-100">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 150px; object-fit: cover;">
    }
    else
    {
        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
            <i class="ri-restaurant-line fa-3x text-muted"></i>
        </div>
    }

    <div class="card-body d-flex flex-column">
        <h6 class="card-title fw-bold">@Model.Name</h6>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="card-text text-muted small">@Model.Description</p>
        }

        <div class="mt-auto">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold text-primary">
                    @Model.DefaultServingPrice.ToString("N0")₫
                </span>
                <small class="text-muted">
                    @Model.Category?.Name
                </small>
            </div>

            <!-- Quantity Selector -->
            <div class="quantity-selector mb-2">
                <button class="quantity-btn" onclick="changeQuantity('@Model.DishId', -1)">
                    <i class="ri-subtract-line"></i>
                </button>
                <input type="number" class="quantity-input" id="quantity-@Model.DishId" value="1" min="1" max="99" readonly>
                <button class="quantity-btn" onclick="changeQuantity('@Model.DishId', 1)">
                    <i class="ri-add-line"></i>
                </button>
            </div>

            <button class="btn btn-add-to-cart w-100" onclick="addToCart('@Model.DishId')">
                <i class="ri-shopping-cart-line me-1"></i>
                Thêm vào giỏ
            </button>
        </div>
    </div>
</div>