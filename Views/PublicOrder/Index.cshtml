@using QuanLiKhoHang.Models.Entities
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = ViewBag.Table as RestaurantTable;
    var dishes = ViewBag.Dishes as List<Dish>;
    var categories = ViewBag.Categories as List<Category>;
    var cart = ViewBag.Cart as Dictionary<Guid, int>;
    var cartCount = cart?.Sum(x => x.Value) ?? 0;
}

<div class="container-fluid py-4">
    <!-- Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="menu-card p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="h3 mb-2">
                        <i class="ri-restaurant-line text-primary me-2"></i>
                        @ViewBag.Title
                    </h1>
                    <div class="table-info">
                        <div class="row">
                            <div class="col-md-6">
                                <i class="ri-chair-line me-2"></i>
                                <strong>Bàn:</strong> @table?.Name
                                @if (!string.IsNullOrEmpty(table?.Area))
                                {
                                    <span class="ms-2">
                                        <i class="ri-map-pin-line me-1"></i>
                                        @table.Area
                                    </span>
                                }
                            </div>
                            <div class="col-md-6 text-md-end">
                                <i class="ri-group-line me-2"></i>
                                <strong>Sức chứa:</strong> @table?.Seats người
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>    <div class="row">
        <!-- Menu Content -->
        <div class="col-lg-8">
            <div class="menu-card p-4">
                <!-- Category Tabs -->
                <ul class="nav nav-tabs category-tabs mb-4" id="categoryTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab">
                            <i class="ri-grid-line me-1"></i>Tất cả
                        </button>
                    </li>
                    @foreach (var category in categories ?? new List<Category>())
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="cat-@category.CategoryId-tab" data-bs-toggle="tab" data-bs-target="#cat-@category.CategoryId" type="button" role="tab">
                                @category.Name
                            </button>
                        </li>
                    }
                </ul>

                <!-- Dishes Content -->
                <div class="tab-content" id="categoryTabsContent">
                    <!-- All Dishes -->
                    <div class="tab-pane fade show active" id="all" role="tabpanel">
                        <div class="row g-3">
                            @foreach (var dish in dishes?.Where(d => d.Active) ?? new List<Dish>())
                            {
                                <div class="col-md-6 col-lg-4">
                                    @await Html.PartialAsync("_DishCard", dish)
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Category-specific Dishes -->
                    @foreach (var category in categories ?? new List<Category>())
                    {
                        <div class="tab-pane fade" id="cat-@category.CategoryId" role="tabpanel">
                            <div class="row g-3">
                                @foreach (var dish in dishes?.Where(d => d.CategoryId == category.CategoryId && d.Active) ?? new List<Dish>())
                                {
                                    <div class="col-md-6 col-lg-4">
                                        @await Html.PartialAsync("_DishCard", dish)
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cart Sidebar -->
        <div class="col-lg-4">
            <div class="cart-sidebar p-4" id="cartSidebar" style="display: none;">
                <h4 class="mb-3">
                    <i class="ri-shopping-cart-line text-primary me-2"></i>
                    Giỏ hàng của bạn
                </h4>

                <div id="cartItems">
                    @if (cart == null || !cart.Any())
                    {
                        <div class="empty-cart">
                            <i class="ri-shopping-cart-line"></i>
                            <p>Giỏ hàng trống</p>
                            <small>Hãy chọn món ăn bạn thích</small>
                        </div>
                    }
                    else
                    {
                        <div class="cart-items-list">
                            <!-- Cart items will be loaded via AJAX -->
                        </div>
                    }
                </div>

                @if (cart != null && cart.Any())
                {
                    <div class="mt-3 pt-3 border-top">
                        <button class="btn btn-checkout btn-lg w-100" onclick="proceedToCheckout()">
                            <i class="ri-arrow-right-line me-2"></i>
                            Tiến hành đặt hàng
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Override global addToCart with page-specific implementation
        window.addToCart = function(dishId) {
            const quantityInput = document.getElementById('quantity-' + dishId);
            const quantity = parseInt(quantityInput.value) || 1;

            $.post('/PublicOrder/AddToCart', {
                dishId: dishId,
                quantity: quantity
            })
            .done(function(response) {
                if (response.success) {
                    updateCartBadge(response.cartCount);
                    loadCartItems();
                    showToast('Đã thêm ' + quantity + ' phần vào giỏ hàng!', 'success');
                    // Reset quantity to 1 after adding
                    quantityInput.value = 1;
                }
            })
            .fail(function() {
                showToast('Có lỗi xảy ra!', 'danger');
            });
        };

        // Change quantity function
        function changeQuantity(dishId, delta) {
            const input = document.getElementById('quantity-' + dishId);
            let currentValue = parseInt(input.value) || 1;
            let newValue = currentValue + delta;

            // Ensure quantity is between 1 and 99
            newValue = Math.max(1, Math.min(99, newValue));
            input.value = newValue;
        }

        // Override global showCart with page-specific implementation
        window.showCart = function() {
            const sidebar = $('#cartSidebar');
            const isVisible = sidebar.is(':visible');

            if (isVisible) {
                sidebar.slideUp();
            } else {
                sidebar.slideDown();
                loadCartItems();
            }
        };

        // Load cart items
        function loadCartItems() {
            // This would load cart items via AJAX
            // For now, just show the sidebar
            console.log('Loading cart items...');
        }

        // Proceed to checkout
        function proceedToCheckout() {
            window.location.href = '/PublicOrder/Checkout?tableId=' + tableId;
        }

        // Initialize
        $(document).ready(function() {
            updateCartBadge(@cartCount);
        });
    </script>
}