@using QuanLiKhoHang.Models.Entities
@using QuanLiKhoHang.Models.Enums
@{
    var branches = ViewBag.Branches as List<Branch>;
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="~/Dashboard">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="~/Table">Quản lý bàn ăn</a></li>
                        <li class="breadcrumb-item active">@ViewBag.Title</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Thông tin bàn ăn</h3>
                        </div>

                        <form method="post" class="card-body">
                            @Html.AntiForgeryToken()
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Code">Mã bàn <span class="text-danger">*</span></label>
                                        <input type="text" id="Code" name="Code" class="form-control" required maxlength="20" placeholder="Ví dụ: CN001-T001" />
                                        <small class="form-text text-muted">Mã bàn phải là duy nhất trong hệ thống</small>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Name">Tên bàn <span class="text-danger">*</span></label>
                                        <input type="text" id="Name" name="Name" class="form-control" required maxlength="100" placeholder="Ví dụ: Bàn 01" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="BranchId">Chi nhánh <span class="text-danger">*</span></label>
                                        <select id="BranchId" name="BranchId" class="form-control" required>
                                            <option value="">Chọn chi nhánh</option>
                                            @if (branches != null)
                                            {
                                                foreach (var branch in branches)
                                                {
                                                    <option value="@branch.BranchId">@branch.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Area">Khu vực <span class="text-danger">*</span></label>
                                        <input type="text" id="Area" name="Area" class="form-control" required maxlength="100" placeholder="Ví dụ: Tầng 1, Sân thượng" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Seats">Số ghế <span class="text-danger">*</span></label>
                                        <input type="number" id="Seats" name="Seats" class="form-control" required min="1" max="20" value="4" />
                                        <small class="form-text text-muted">Số lượng ghế ngồi (1-20)</small>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="IsOutdoor">Vị trí bàn <span class="text-danger">*</span></label>
                                        <select id="IsOutdoor" name="IsOutdoor" class="form-control" required>
                                            <option value="false">Trong nhà</option>
                                            <option value="true">Ngoài trời</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Status">Trạng thái</label>
                                        <select id="Status" name="Status" class="form-control">
                                            <option value="Available">Trống</option>
                                            <option value="Occupied">Đang sử dụng</option>
                                            <option value="Reserved">Đã đặt</option>
                                            <option value="OutOfService">Bảo trì</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Lưu bàn ăn
                                </button>
                                <a href="~/Table" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Quay lại
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>