@using QuanLiKhoHang.Models.Entities
@{
    var items = ViewBag.Items as List<Supplier>;
    int page = (int)ViewBag.CurrentPage;
    int total = (int)ViewBag.TotalPages;
    string search = (string)ViewBag.SearchTerm;
    string sort = (string)ViewBag.SortOrder;
}

<div class="mb-3">
    <a href="@Url.Action("Create")" class="btn btn-primary">Tạo nhà cung cấp mới</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Tìm theo tên hoặc liên hệ..." />
        
        <button type="submit" class="btn btn-outline-secondary">Tìm</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Liên hệ</th>
            <th>Điện thoại</th>
            <th>Email</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (items != null && items.Any())
        {
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.PrimaryContactName</td>
                    <td>@item.Phone</td>
                    <td>@item.Email</td>
                    <td>@(item.IsActive ? "Hoạt động" : "Không hoạt động")</td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a href="@Url.Action("Details", new { id = item.SupplierId })" class="btn btn-sm btn-info">Chi tiết</a>
                        <a href="@Url.Action("TransactionHistory", new { id = item.SupplierId })" class="btn btn-sm btn-primary">Lịch sử giao dịch</a>
                        <a href="@Url.Action("Edit", new { id = item.SupplierId })" class="btn btn-sm btn-warning">Sửa</a>
                        <form method="post" action="@Url.Action("Delete", new { id = item.SupplierId })" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn xóa?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">Không có dữ liệu</td>
            </tr>
        }
    </tbody>
</table>

@if (total > 1)
{
    <nav aria-label="Phân trang">
        <ul class="pagination">
            @if (page > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { search, sort, page = page - 1 })">Trước</a>
                </li>
            }
            @for (int i = Math.Max(1, page - 2); i <= Math.Min(total, page + 2); i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search, sort, page = i })">@i</a>
                </li>
            }
            @if (page < total)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { search, sort, page = page + 1 })">Sau</a>
                </li>
            }
        </ul>
    </nav>
}