@using QuanLiKhoHang.Models.Entities
@model Supplier
@{
    ViewBag.Title = ViewBag.Title ?? "Tạo nhà cung cấp";
}

<h3>@ViewBag.Title</h3>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">

        <input type="hidden" name="CreatedAt" value="@Model?.CreatedAt" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Tên <span class="text-danger">*</span></label>
        <input name="Name" value="@Model?.Name" class="form-control" required />
        @Html.ValidationMessage("Name", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label">Mã nhà cung cấp <span class="text-danger">*</span></label>
        <input name="SupplierCode" value="@((Model?.SupplierCode) ?? ("NCC" + DateTime.Now.ToString("yyyyMMddHHmmss") + Guid.NewGuid().ToString("N").Substring(0,3).ToUpper()))" class="form-control" required maxlength="32" readonly />
        @Html.ValidationMessage("SupplierCode", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label">Người liên hệ</label>
        <input name="PrimaryContactName" value="@Model?.PrimaryContactName" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Số điện thoại</label>
        <input name="Phone" value="@Model?.Phone" class="form-control" />
        @Html.ValidationMessage("Phone", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input name="Email" value="@Model?.Email" type="email" class="form-control" />
        @Html.ValidationMessage("Email", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label">Địa chỉ</label>
        <textarea name="Address" class="form-control">@Model?.Address</textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Điều khoản thanh toán</label>
        <input name="PaymentTerms" value="@Model?.PaymentTerms" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tiền tệ</label>
        <input name="Currency" value="@Model?.Currency" class="form-control" />
    </div>

    <div class="mb-3">
        <div class="form-check">
            @* Hidden input ensures a value is posted when checkbox is unchecked *@
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label class="form-check-label" for="IsActive">
                Đang hoạt động
            </label>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
</form>