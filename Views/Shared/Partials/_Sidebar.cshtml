                <a href="javascript:void(0)" title="POS - Bán hàng">
                    <i class="ri-calendar-line menu-icon"></i>
                    <span>Đặt bàn & Giao hàng</span>
                </a>
                <ul class="sidebar-submenu">
                    @if (User.HasPermission(PermissionConstants.VIEW_RESERVATION))
                    {
                        <li>
                            <a href="@Url.Action("Index", "Reservation")"><i class="ri-circle-fill circle-icon text-primary-600 w-auto"></i> Đặt bàn</a>
                        </li>
                    }
                    @if (User.HasPermission(PermissionConstants.MANAGE_ONLINE_ORDER))
                    {
                        <li>
                            <a href="#"><i class="ri-circle-fill circle-icon text-warning-main w-auto"></i> Đặt món online</a>
                        </li>
                    }
                    @if (User.HasPermission(PermissionConstants.MANAGE_DELIVERY))
                    {
                        <li>
                            <a href="#"><i class="ri-circle-fill circle-icon text-info-main w-auto"></i> Quản lý giao hàng</a>
                        </li>
                    }
                </ul>
            </li> *@

            <li class="dropdown">
                <a href="javascript:void(0)" title="Đặt bàn & Giao hàng">
                    <i class="ri-truck-line menu-icon"></i>
                    <span>Nhà cung cấp</span>
                </a>
                <ul class="sidebar-submenu">
                    @if (User.HasPermission(PermissionConstants.VIEW_SUPPLIER))
                    {
                        <li>
                            <a href="@Url.Action("Index", "Supplier")"><i
                                    class="ri-circle-fill circle-icon text-primary-600 w-auto"></i> Quản lý thông tin</a>
                        </li>
                    }
                 

                </ul>
            </li>

            @if (User.HasAnyPermission(PermissionConstants.VIEW_REVENUE_REPORT, PermissionConstants.VIEW_FINANCE_REPORT,
