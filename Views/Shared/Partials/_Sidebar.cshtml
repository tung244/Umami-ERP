        </a>
    </div>
    <div class="sidebar-menu-area">
        <ul class="sidebar-menu" id="sidebar-menu">
            <li class="dropdown">
                <a href="javascript:void(0)" title="Dashboard">
                    <i class="ri-home-4-line menu-icon"></i>
                    <span>Dashboard</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a href="@Url.Action("Index2", "Dashboard")"><i
                                class="ri-circle-fill circle-icon text-primary-600 w-auto"></i> Tổng quan</a>
                    </li>
                </ul>
            </li>

            <li class="sidebar-menu-group-title">Quản lý nhà hàng</li>

            <li class="dropdown">
                <a href="javascript:void(0)" title="Quản lý thực đơn">
