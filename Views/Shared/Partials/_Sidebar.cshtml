                    @if (User.HasPermission(PermissionConstants.VIEW_DISH))
                    {
                        <li>
                            <a href="@Url.Action("Index", "Dish")"><i
                                    class="ri-circle-fill circle-icon text-warning-main w-auto"></i> Món ăn</a>
                        </li>
