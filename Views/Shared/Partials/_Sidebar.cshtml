                alt="site logo" class="light-logo">
            <img style="width: 200px;"
                src="https://res.cloudinary.com/dxnoonrrd/image/upload/v1763259054/Hehe_Restaurant_uu4kpf.png"
                alt="site logo" class="dark-logo">
            <img style="width: 200px;"
                src="https://res.cloudinary.com/dxnoonrrd/image/upload/v1763259054/Hehe_Restaurant_uu4kpf.png"
