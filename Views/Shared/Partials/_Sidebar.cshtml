@using QuanLiKhoHang.Extensions;
@using QuanLiKhoHang.Constants;

@{
}
<aside class="sidebar">
    <button type="button" class="sidebar-close-btn" title="Đóng">
        <i class="ri-close-line"></i>
    </button>
    <div>
        <a href="@Url.Action("Index2", "Dashboard")" class="sidebar-logo">
            <img style="width: 200px;"
