@using QuanLiKhoHang.Models.Entities
@using QuanLiKhoHang.Models.Enums
@model PayrollRecord
@{
    var staffList = ViewBag.StaffList as List<Staff>;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Thêm bảng lương mới</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <!-- Thông tin cơ bản -->
                        <div class="col-md-6">
                            <h6 class="mb-3">Thông tin bảng lương</h6>

                            <div class="mb-3">
                                <label for="StaffId" class="form-label">Nhân viên <span class="text-danger">*</span></label>
                                <select class="form-select" id="StaffId" name="StaffId" required>
                                    <option value="">Chọn nhân viên</option>
                                    @if (staffList != null)
                                    {
                                        foreach (var staff in staffList)
                                        {
                                            <option value="@staff.StaffId" selected="@(Model?.StaffId == staff.StaffId)">
                                                @staff.EmployeeNumber - @staff.FirstName @staff.LastName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="PayrollPeriodStart" class="form-label">Kỳ lương từ <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="PayrollPeriodStart" name="PayrollPeriodStart"
                                       value="@Model?.PayrollPeriodStart.ToString("yyyy-MM-dd")" required>
                            </div>

                            <div class="mb-3">
                                <label for="PayrollPeriodEnd" class="form-label">Kỳ lương đến <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="PayrollPeriodEnd" name="PayrollPeriodEnd"
                                       value="@Model?.PayrollPeriodEnd.ToString("yyyy-MM-dd")" required>
                            </div>

                            <div class="mb-3">
                                <label for="GrossPay" class="form-label">Tổng lương <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" id="GrossPay" name="GrossPay"
                                       value="@Model?.GrossPay" required min="0">
                            </div>

                            <div class="mb-3">
                                <label for="Deductions" class="form-label">Khấu trừ</label>
                                <input type="number" step="0.01" class="form-control" id="Deductions" name="Deductions"
                                       value="@Model?.Deductions" min="0">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h6 class="mb-3">Thông tin thanh toán</h6>

                          

                           

                            <div class="mb-3">
                                <label for="PaymentMethod" class="form-label">Phương thức thanh toán <span class="text-danger">*</span></label>
                                <select class="form-select" id="PaymentMethod" name="PaymentMethod" required>
                                    <option value="@PayrollPaymentMethod.Cash" selected="@(Model?.PaymentMethod == PayrollPaymentMethod.Cash)">Tiền mặt</option>
                                    <option value="@PayrollPaymentMethod.BankTransfer" selected="@(Model?.PaymentMethod == PayrollPaymentMethod.BankTransfer)">Chuyển khoản</option>
                                    <option value="@PayrollPaymentMethod.Check" selected="@(Model?.PaymentMethod == PayrollPaymentMethod.Check)">Séc</option>
                                    <option value="@PayrollPaymentMethod.DigitalWallet" selected="@(Model?.PaymentMethod == PayrollPaymentMethod.DigitalWallet)">Ví điện tử</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="PaidAt" class="form-label">Ngày thanh toán</label>
                                <input type="datetime-local" class="form-control" id="PaidAt" name="PaidAt"
                                       value="@Model?.PaidAt?.ToString("yyyy-MM-ddTHH:mm")">
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>